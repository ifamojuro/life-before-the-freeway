# Staging profile for Life Before the Freeway.
#
# Copy to backend/.env.staging (gitignored), fill in, then:
#   make dev-staging        local server against the staging database
#   make migrate-staging    apply migrations to the staging database
# and upload the same file to Render as a Secret File named ".env.staging";
# the start command in render.yaml sources it from /etc/secrets/.
#
# Every setting the app reads is listed here. Startup refuses to run if a
# chosen mode is missing its required settings (see app/config.py::validate).

# --- database (Neon) ------------------------------------------------------
# Pooled connection string, used by the app.
LBTF_DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-west-2.aws.neon.tech/lbtf?sslmode=require
# Direct (non-pooled) connection string, used for migrations. Optional; falls
# back to LBTF_DATABASE_URL.
LBTF_MIGRATE_DATABASE_URL=postgresql://user:password@ep-xxx.us-west-2.aws.neon.tech/lbtf?sslmode=require

# --- seeding ----------------------------------------------------------------
# base = prompt bank + first admin only. Never "sample" here: that is the fake
# archive for local dev. Use "none" after restoring a dump.
LBTF_SEED=base
LBTF_ADMIN_EMAIL=you@example.org
LBTF_ADMIN_PASSWORD=change-me
LBTF_ADMIN_NAME=Ife

# --- site ---------------------------------------------------------------------
# Shared preview password (HTTP Basic). Unset = the site is public.
LBTF_SITE_PASSWORD=change-me
# mock = deterministic offline transcription (Whisper won't fit the free instance).
LBTF_TRANSCRIBER=mock

# --- video storage (Cloudflare R2) — Phase 4, not read by the app yet ------------
# LBTF_STORAGE=r2
# LBTF_R2_BUCKET=lbtf-media
# LBTF_R2_ACCOUNT_ID=
# LBTF_R2_ACCESS_KEY_ID=
# LBTF_R2_SECRET_ACCESS_KEY=
# LBTF_R2_PUBLIC_URL=https://pub-xxx.r2.dev
